# PostgreSQL credentials (used by start_pod.sh)
POSTGRES_DB=FantacalcioDb
POSTGRES_USER=fantahelp
POSTGRES_PASSWORD=fantahelp_password

# App connection string (Npgsql format)
# The app reads this from appsettings.json ConnectionStrings:DefaultConnection
# or from the environment variable DefaultConnection
# For convenience, you can also set it directly in appsettings.json:
#   "DefaultConnection": "Host=localhost;Port=5432;Database=FantacalcioDb;Username=fantahelp;Password=fantahelp_password"
